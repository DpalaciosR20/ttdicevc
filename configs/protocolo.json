  "contraste": {
    "_seccion": "§5",
    "formulacion": "B",
    "r": 0.5,
    "f1_azar": 0.5,
    "statistic": "theta = (F1_img - f1_azar) - r * (F1_BETO - f1_azar)",
    "h1": "theta > 0",
    "bootstrap": {
      "B": 10000,
      "rng": "numpy.random.default_rng",
      "seed": 2026,
      "resample": "indices de test con reemplazo",
      "n": "n.test",
      "paired": true,
      "recompute": ["beto", "finalistas (cada semilla)", "pisos", "referencias"]
