      "statistic": "D = F1_img - F1_piso",
      "h1": "D > 0",
      "stratified_as_constant": 0.5,
      "visual_permutado": "mean_over_seeds_per_replicate"
    },
    "multiplicidad": {
      "alpha": 0.05,
      "sided": "one",
      "method": "holm",
      "families": ["superioridad_piso", "no_inferioridad"],
      "family_size": 3,
      "interval": {
        "type": "percentile_two_sided",
        "level": "1 - 2 * alpha_h",
        "alpha_h_from": "no_inferioridad",
        "quantile_method": "linear"
      },
      "ties": "min_alpha_h"
    },
    "veredictos": {
      "order": ["V3", "V1", "V2", "V4"],
      "V3": "no se rechaza H0 de superioridad sobre el piso (Holm)",
      "V1": "supera el piso y se rechaza H0 de no inferioridad (Holm)",
      "V2": "supera el piso y el límite superior del intervalo de theta es < 0",
      "V4": "supera el piso y no se cumplen V1 ni V2"
    },
    "global": {
      "order": ["G1", "G2", "G3", "G4"],
      "G1": "al menos una técnica con V1",
      "G2": "al menos una técnica con V2",
      "G3": "las tres técnicas con V3",
      "G4": "en otro caso"
    },
    "retencion": {"statistic": "rho = (F1_img - f1_azar) / (F1_BETO - f1_azar)", "interval_level": 0.95, "descriptive": true}
  },
  "longitud": {
    "_seccion": "§6",
    "task": "F4.5",
