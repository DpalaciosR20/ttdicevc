{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ttdicevc/canonical_numbers/1.0",
 "title": "Cifras canónicas de TTDICEVC (plan v2, F0.4)",
 "description": "Archivo generado por src/canonical/build.py. Cada cifra del documento de TT-II se toma de aquí.",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema_version", "inputs", "numbers"],
 "properties": {
  "schema_version": {"const": "1.0"},
  "inputs": {
   "description": "Insumos leídos por build.py: ruta (relativa al repo, o nombre del artefacto externo) → sha256.",
   "type": "object",
   "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "numbers": {
   "type": "object",
   "propertyNames": {"pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"},
   "additionalProperties": {"$ref": "#/$defs/entry"}
  },
  "superseded": {
   "description": "Entradas sustituidas por otra que declara supersedes: id → origen de ambas y entrada original intacta.",
   "type": "object",
   "propertyNames": {"pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"},
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["by", "origin", "entry"],
    "properties": {
     "by": {"type": "string", "minLength": 1},
     "origin": {"type": "string", "minLength": 1},
     "entry": {"$ref": "#/$defs/entry"}
    }
   }
  }
 },
 "$defs": {
  "fragment": {
   "description": "results/<tarea>/canonical_fragment.json: solo cifras, sin inputs.",
   "type": "object",
   "additionalProperties": false,
   "required": ["schema_version", "numbers"],
   "properties": {
    "schema_version": {"const": "1.0"},
    "numbers": {
     "type": "object",
     "propertyNames": {"pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"},
     "additionalProperties": {"$ref": "#/$defs/entry"}
    }
   }
  },
  "split_value": {"type": ["number", "null"]},
  "confusion": {
   "type": "object",
   "additionalProperties": false,
   "required": ["tp", "fp", "fn", "tn"],
   "properties": {
    "tp": {"type": "integer", "minimum": 0},
    "fp": {"type": "integer", "minimum": 0},
    "fn": {"type": "integer", "minimum": 0},
    "tn": {"type": "integer", "minimum": 0}
   }
  },
  "source": {
   "oneOf": [
    {
     "description": "Archivo del repo (la prueba verifica que exista).",
     "type": "object",
     "additionalProperties": false,
     "required": ["path", "locator"],
     "properties": {"path": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1}}
    },
    {
     "description": "Artefacto externo (no está en git), identificado por sha256.",
     "type": "object",
     "additionalProperties": false,
     "required": ["artifact", "sha256", "locator"],
     "properties": {
      "artifact": {"type": "string", "minLength": 1},
      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "locator": {"type": "string", "minLength": 1}
     }
    }
   ]
  },
  "entry": {
   "type": "object",
   "additionalProperties": false,
   "required": ["kind", "status", "value", "evaluator", "source"],
   "properties": {
    "kind": {"enum": ["metric", "count"]},
    "status": {
     "description": "verificado: recalculado por build.py desde datos por muestra. extraido: leído por código de un artefacto del repo, sin recálculo por muestra. reportado: transcrito de un documento. exploratorio: usa un test consultado antes de congelar el protocolo.",
     "enum": ["verificado", "extraido", "reportado", "exploratorio"]
    },
    "metric": {"enum": ["f1_macro"]},
    "value": {},
    "null_reason": {
     "type": "object",
     "additionalProperties": false,
     "properties": {"val": {"type": "string", "minLength": 1}, "test": {"type": "string", "minLength": 1}}
    },
    "evaluator": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/source"},
    "decimals": {"description": "Decimales con que se reportó la cifra transcrita.", "type": "integer", "minimum": 0},
    "confusion": {
     "type": "object",
     "additionalProperties": false,
     "properties": {"val": {"$ref": "#/$defs/confusion"}, "test": {"$ref": "#/$defs/confusion"}}
    },
    "supports_ref": {
     "description": "Prefijo de los conteos por clase de cada split (p. ej. support.val → support.val.label0/label1).",
     "type": "object",
     "additionalProperties": false,
     "properties": {"val": {"type": "string"}, "test": {"type": "string"}}
    },
    "depends_on": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "derivation": {"enum": ["sum", "mean", "std_ddof1", "diff"]},
    "supersedes": {
     "description": "Id de la entrada que esta sustituye (puede ser el mismo id). build.py la retira de numbers y la conserva en superseded.",
     "type": "string",
     "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
    },
    "summarizes": {
     "description": "Agregado transcrito (no derivado): la prueba comprueba que sea compatible, a sus decimales, con op aplicado a las cifras of.",
     "type": "object",
     "additionalProperties": false,
     "required": ["of", "op"],
     "properties": {
      "of": {"type": "array", "minItems": 2, "items": {"type": "string"}},
      "op": {"enum": ["mean", "std_ddof0", "std_ddof1"]}
     }
    },
    "xfail": {
     "type": "object",
     "additionalProperties": false,
     "required": ["reason"],
     "properties": {"reason": {"type": "string", "minLength": 1}}
    },
    "note": {"type": "string"}
   },
   "dependentRequired": {"depends_on": ["derivation"], "derivation": ["depends_on"]},
   "allOf": [
    {
     "if": {"properties": {"kind": {"const": "metric"}}},
     "then": {
      "required": ["metric", "supports_ref"],
      "properties": {
       "value": {
        "type": "object",
        "additionalProperties": false,
        "required": ["val", "test"],
        "properties": {"val": {"$ref": "#/$defs/split_value"}, "test": {"$ref": "#/$defs/split_value"}}
       }
      }
     },
     "else": {"properties": {"value": {"type": "integer"}}, "not": {"required": ["metric"]}}
    },
    {
     "if": {"properties": {"kind": {"const": "metric"}, "value": {"properties": {"val": {"type": "null"}}}}},
     "then": {"required": ["null_reason"], "properties": {"null_reason": {"required": ["val"]}}}
    },
    {
     "if": {"properties": {"kind": {"const": "metric"}, "value": {"properties": {"test": {"type": "null"}}}}},
     "then": {"required": ["null_reason"], "properties": {"null_reason": {"required": ["test"]}}}
    },
    {
     "if": {
      "properties": {"kind": {"const": "metric"}, "status": {"enum": ["reportado", "exploratorio"]}},
      "not": {"required": ["depends_on"]}
     },
     "then": {"required": ["decimals"]}
    },
    {
     "if": {
      "properties": {"kind": {"const": "metric"}, "status": {"const": "verificado"}},
      "not": {"required": ["depends_on"]}
     },
     "then": {"required": ["confusion"]}
    }
   ]
  }
 }
}
